# Idle keeps the service running without claiming jobs.
WORKER_MODE=idle
# Delay between polls when no job is available or after an API failure.
HEARTBEAT_SECONDS=60

# Set WORKER_MODE=api to enable structured imports.
# Use an HTTPS origin without a path. Local HTTP is accepted for development.
# VLEARN_API_URL=https://learn.example.com
# VLEARN_SERVICE_TOKEN=

# Deprecated bootstrap placeholders. The API supplies files under a fenced lease.
# CF_ACCOUNT_ID=
# CF_QUEUE_ID=
# CF_QUEUE_TOKEN=
# R2_BUCKET=
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
